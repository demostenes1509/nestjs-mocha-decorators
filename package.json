{
  "name": "nestjs-mocha-decorators",
  "version": "2.0.0",
  "description": "Use test decorators to run your Nest.js test suite using mocha internally",
  "author": "Maximiliano Carrizo",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "mocha --require ts-node/register \"test/unit/**/*.spec.ts\"",
    "test:e2e": "mocha --delay --exit --require ts-node/register test/test.entrypoint.ts"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "mocha": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "axios": "^1.3.4",
    "eslint": "^10.0.0",
    "expect": "^30.0.0",
    "mocha": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.0",
    "rxjs": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "keywords": [
    "nest.js",
    "nestjs",
    "nest",
    "mocha",
    "decorators"
  ],
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/demostenes1509/nestjs-mocha-decorators",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demostenes1509/nestjs-mocha-decorators.git"
  },
  "bugs": {
    "url": "https://github.com/demostenes1509/nestjs-mocha-decorators/issues"
  }
}
